:80 {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /voice/* {
		reverse_proxy api:8000
	}
	handle /ws/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}
