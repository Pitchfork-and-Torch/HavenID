# HavenID local / VPS config. Copy to .env and fill in.
# Never commit a filled .env.

HAVEN_ENV=dev
HAVEN_SECRET_KEY=change-me-to-a-long-random-string
HAVEN_DATA_KEY=change-me-fernet-key
HAVEN_PUBLIC_URL=http://localhost:3000
HAVEN_DOMAIN=localhost
COOKIE_SECURE=false

# Owner bootstrap (used only when the users table is empty)
BOOTSTRAP_EMAIL=you@example.com
BOOTSTRAP_PASSWORD=change-me-strong-password
ALLOW_SIGNUP=false

# Postgres (compose) or SQLite for unit tests
DATABASE_URL=postgresql+asyncpg://haven:haven@postgres:5432/havenid
# Local API without compose:
# DATABASE_URL=sqlite+aiosqlite:///./havenid.db

REDIS_URL=redis://redis:6379/0
# Leave empty to use in-process memory (pytest / tiny local)

# Twilio (optional until Phase 3 live test)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TRIAL=true

# Optional Grok classify
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast
XAI_API_BASE=https://api.x.ai/v1

# Optional SMTP for voicemail / recovery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

RECORDINGS_DIR=/data/recordings
